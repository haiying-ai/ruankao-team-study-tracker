{
  "name": "ruankao-team-study-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -b",
    "setup:cloudbase": "tsx scripts/setup-cloudbase.ts",
    "validate:cloudbase": "tcb --config-file cloudbaserc.example.json validate",
    "deploy": "powershell -ExecutionPolicy Bypass -File scripts/deploy-cloudbase.ps1",
    "deploy:plan": "powershell -ExecutionPolicy Bypass -File scripts/deploy-cloudbase.ps1 -PlanOnly",
    "deploy:api": "powershell -ExecutionPolicy Bypass -File scripts/deploy-cloudbase.ps1 -Target Api",
    "deploy:frontend": "powershell -ExecutionPolicy Bypass -File scripts/deploy-cloudbase.ps1 -Target Frontend",
    "deploy:notification": "powershell -ExecutionPolicy Bypass -File scripts/deploy-cloudbase.ps1 -Target Notification"
  },
  "dependencies": {
    "@cloudbase/node-sdk": "^3.14.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "pinia": "^3.0.3",
    "serverless-http": "^4.0.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@cloudbase/cli": "^3.8.1",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
